<?xml version="1.0" encoding="utf-8"?>
<!-- Everything stays HTTPS-only except the DisasterX offline gateway, an
     ESP32 on its own Wi-Fi that only speaks plain HTTP. In debug builds
     Metro (localhost / 10.0.2.2) also needs plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
